# /etc/water-erp/env   (chmod 600, owner root; contains secrets)
# --- server mode: local (plant LAN) or domain (public HTTPS) ---
ERP_MODE=domain
ERP_DOMAIN=erp.example.com
ERP_BIND=0.0.0.0:443
ERP_TLS_CERT=/etc/letsencrypt/live/erp.example.com/fullchain.pem
ERP_TLS_KEY=/etc/letsencrypt/live/erp.example.com/privkey.pem
# --- local LAN example (self-signed CA is generated under ERP_DATA_DIR/tls; install local-ca.pem on phones) ---
# ERP_MODE=local
# ERP_DOMAIN=erp.plant.lan
# ERP_BIND=0.0.0.0:8443
ERP_DATA_DIR=/var/lib/water-erp
ERP_STATIC_DIR=/opt/water-erp/static
DATABASE_URL=postgres://erp:CHANGE-ME@127.0.0.1:5432/water_erp
# --- Web Push (generate once with:  water-erp gen-vapid) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# first Admin (only used with --setup-admin <username>, e.g. in ExecStart for the very first start; remove afterwards)
# ERP_ADMIN_PASSWORD=
RUST_LOG=info,sqlx=warn,tower_http=info
